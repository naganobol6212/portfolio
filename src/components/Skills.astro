---
import Section from './Section.astro';
import { SKILLS, FUTURE_STACK } from '../data/skills';
---

<Section id="skills" number="04" eyebrow="スキル" title="CAPABILITIES" numberPosition="left">
  <p class="mb-8 max-w-2xl text-sm leading-relaxed text-[--color-mute] md:text-base">
    実務はこれから。個人開発を通じて手を動かしてきた領域です。
  </p>

  <div class="overflow-hidden brutal-border">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
      {
        SKILLS.map((group) => (
          <div class="group -mb-[3px] -mr-[3px] border-b-[3px] border-r-[3px] border-[--color-ink] p-6 transition-none hover:bg-[--color-ink] hover:text-[--color-paper] md:p-8">
            <h4
              class="display-mega text-xl md:text-2xl"
              style="font-family: var(--font-display);"
            >
              {group.heading}
            </h4>
            <p class="mt-4 text-sm leading-relaxed text-[--color-mute] group-hover:text-[--color-paper] md:text-base">
              {group.items}
            </p>
          </div>
        ))
      }
    </div>
  </div>

  <div class="mt-10 brutal-border bg-[--color-surface-dim] p-6 md:p-8">
    <div class="flex flex-col gap-3 md:flex-row md:items-center md:gap-6">
      <span class="eyebrow-chip whitespace-nowrap">これから業務で扱う</span>
      <p class="text-sm font-bold md:text-base">
        {FUTURE_STACK.join('　/　')}
      </p>
    </div>
  </div>
</Section>
