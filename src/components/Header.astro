---
import { NAV, SITE } from '../consts';
---

<header class="sticky top-0 z-50 border-b border-[--color-line] bg-[--color-paper]/85 backdrop-blur">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <a href="/" class="font-mono text-sm tracking-tight hover:opacity-70">
      {SITE.author}<span class="text-[--color-mute]">/portfolio</span>
    </a>
    <nav aria-label="Primary">
      <ul class="hidden gap-7 text-sm md:flex">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} class="text-[--color-mute] transition hover:text-[--color-ink]">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <details class="md:hidden">
        <summary class="cursor-pointer list-none p-2 text-sm" aria-label="メニュー">≡</summary>
        <ul class="absolute right-4 mt-2 w-44 rounded-md border border-[--color-line] bg-[--color-paper] p-2 shadow-sm">
          {
            NAV.map((item) => (
              <li>
                <a href={item.href} class="block rounded px-3 py-2 text-sm hover:bg-gray-100">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </nav>
  </div>
</header>
