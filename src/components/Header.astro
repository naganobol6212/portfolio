---
import { NAV, SITE } from '../consts';
---

<header class="sticky top-0 z-50 bg-[--color-paper] brutal-border-b">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 md:px-10">
    <a
      href="/"
      class="font-display text-2xl font-black tracking-tight md:text-3xl"
      style="font-family: var(--font-display);"
    >
      {SITE.author}
    </a>
    <nav aria-label="Primary">
      <ul class="hidden gap-2 md:flex">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                class="inline-flex items-center gap-1.5 border-2 border-transparent px-2.5 py-1.5 text-xs font-bold hover:border-[--color-ink] hover:bg-[--color-ink] hover:text-[--color-paper]"
                style="font-family: var(--font-mono);"
              >
                <span class="opacity-60">{item.number}.</span>
                <span>{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <details class="relative md:hidden">
        <summary class="cursor-pointer list-none border-2 border-[--color-ink] px-3 py-1.5 text-sm font-bold" aria-label="メニュー">
          MENU
        </summary>
        <ul class="absolute right-0 mt-2 w-56 border-2 border-[--color-ink] bg-[--color-paper]">
          {
            NAV.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="flex items-center justify-between border-b border-[--color-ink]/20 px-4 py-3 text-sm font-bold last:border-b-0 hover:bg-[--color-ink] hover:text-[--color-paper]"
                  style="font-family: var(--font-mono);"
                >
                  <span>{item.label}</span>
                  <span class="opacity-60">{item.number}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </nav>
  </div>
</header>
