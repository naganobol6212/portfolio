---
import Section from './Section.astro';
import { SOCIAL } from '../consts';
---

<Section id="contact" number="06" eyebrow="連絡先" title="CONTACT" numberPosition="right">
  <div class="grid gap-10 md:grid-cols-12 md:items-center">
    <div class="md:col-span-6">
      <p class="text-base leading-relaxed md:text-lg">
        現在は GitHub 経由でのご連絡を受け付けています。お仕事のご相談・技術的な議論・カジュアルな雑談、いずれも歓迎です。
      </p>
      <p class="mt-3 text-sm text-[--color-mute]">
        SNS や問い合わせフォームは順次拡充予定です。
      </p>
    </div>

    <div class="md:col-span-6">
      <a
        href={SOCIAL.github}
        target="_blank"
        rel="noopener"
        class="group block brutal-border bg-[--color-paper] p-8 transition-none hover:bg-[--color-ink] hover:text-[--color-paper]"
      >
        <div class="flex items-center justify-between">
          <div>
            <p
              class="text-xs font-bold tracking-widest opacity-60"
              style="font-family: var(--font-mono);"
            >
              / GITHUB
            </p>
            <p
              class="mt-2 display-mega text-2xl md:text-4xl"
              style="font-family: var(--font-display);"
            >
              @naganobol6212
            </p>
          </div>
          <span aria-hidden="true" class="text-3xl md:text-5xl">↗</span>
        </div>
      </a>
    </div>
  </div>
</Section>
