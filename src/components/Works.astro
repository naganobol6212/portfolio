---
import Section from './Section.astro';
import { WORKS } from '../data/works';

const layoutClasses = [
  'md:col-span-7 md:mt-0',
  'md:col-span-5 md:mt-16',
  'md:col-span-6 md:-mt-8',
  'md:col-span-6 md:mt-16',
];
---

<Section id="works" number="03" eyebrow="制作物" title="WORKS" numberPosition="center">
  <div class="mb-10 flex flex-wrap items-end justify-between gap-2">
    <p class="max-w-2xl text-sm leading-relaxed text-[--color-mute] md:text-base">
      個人開発で取り組んだ Web アプリケーション。すべて企画・設計・実装・運用を一人で担当。
    </p>
    <span
      class="text-xs font-bold tracking-widest"
      style="font-family: var(--font-mono);"
    >
      SELECTED [ {WORKS.length} ]
    </span>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-12 md:gap-8">
    {
      WORKS.map((w, i) => (
        <article
          class={`group relative overflow-hidden brutal-border bg-[--color-paper] ${layoutClasses[i] ?? 'md:col-span-6'}`}
        >
          <div class="absolute inset-0 z-0 translate-y-full bg-[--color-ink] transition-transform duration-300 ease-in-out group-hover:translate-y-0" />

          <div class="relative z-10 flex h-full flex-col p-7 group-hover:text-[--color-paper] md:p-8">
            <div class="mb-5 flex items-center gap-3">
              <span
                class="text-xs font-bold tracking-widest opacity-60"
                style="font-family: var(--font-mono);"
              >
                / {String(i + 1).padStart(2, '0')}
              </span>
              <div class="h-px flex-1 bg-current opacity-30" />
            </div>

            <h3
              class="display-mega text-2xl md:text-4xl"
              style="font-family: var(--font-display);"
            >
              {w.title}
            </h3>

            <p class="mt-3 text-sm font-bold md:text-base">{w.tagline}</p>

            <p class="mt-5 flex-1 text-sm leading-relaxed">{w.description}</p>

            <div class="mt-6 border-l-[3px] border-current pl-3 opacity-90">
              <p
                class="text-[10px] font-bold uppercase tracking-widest opacity-70"
                style="font-family: var(--font-mono);"
              >
                Stack
              </p>
              <p class="mt-1 text-xs leading-relaxed md:text-sm">{w.stack.join(' / ')}</p>
            </div>

            <footer class="mt-7 flex flex-wrap items-center justify-between gap-3 border-t-[3px] border-current pt-4">
              <span class="text-xs opacity-70">{w.role}</span>
              <div class="flex gap-2">
                <a
                  href={w.repo}
                  target="_blank"
                  rel="noopener"
                  class="border-2 border-current px-3 py-1.5 text-xs font-bold hover:bg-current hover:text-[--color-ink] group-hover:hover:text-[--color-paper] group-hover:hover:bg-[--color-paper]"
                  style="font-family: var(--font-mono);"
                >
                  GITHUB ↗
                </a>
                {w.demo && (
                  <a
                    href={w.demo}
                    target="_blank"
                    rel="noopener"
                    class="border-2 border-current px-3 py-1.5 text-xs font-bold hover:bg-current hover:text-[--color-ink] group-hover:hover:text-[--color-paper] group-hover:hover:bg-[--color-paper]"
                    style="font-family: var(--font-mono);"
                  >
                    VISIT ↗
                  </a>
                )}
              </div>
            </footer>
          </div>
        </article>
      ))
    }
  </div>
</Section>
