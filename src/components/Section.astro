---
type Props = {
  id: string;
  number: string;
  eyebrow: string;
  title: string;
  numberPosition?: 'left' | 'right' | 'center';
};

const { id, number, eyebrow, title, numberPosition = 'left' } = Astro.props;

const positionClass =
  numberPosition === 'right'
    ? '-right-2 md:-right-10'
    : numberPosition === 'center'
      ? 'left-1/2 -translate-x-1/2'
      : '-left-2 md:-left-10';
---

<section
  id={id}
  class="relative mx-auto max-w-7xl px-5 py-20 md:px-10 md:py-32"
>
  <div
    class={`section-bg-number ${positionClass} -top-6 md:-top-10 text-[140px] md:text-[260px]`}
    aria-hidden="true"
  >
    {number}
  </div>

  <div class="relative z-10">
    <div class="mb-10 flex items-end justify-between gap-4 brutal-border-b pb-5">
      <div class="flex items-center gap-3 md:gap-5">
        <span class="eyebrow-chip">{eyebrow}</span>
        <h2 class="display-mega text-2xl md:text-4xl">{title}</h2>
      </div>
      <a
        href={`#${id}`}
        class="hidden font-bold opacity-60 hover:opacity-100 md:inline-block"
        style="font-family: var(--font-mono);"
      >
        #{id}
      </a>
    </div>
    <slot />
  </div>
</section>
