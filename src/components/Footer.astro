---
import { SITE, SOCIAL } from '../consts';
const year = new Date().getFullYear();
---

<footer class="brutal-border-t mt-10 bg-[--color-paper]">
  <div class="mx-auto max-w-7xl px-5 py-12 md:px-10 md:py-16">
    <div class="grid gap-10 md:grid-cols-12 md:items-end">
      <div class="md:col-span-7">
        <p
          class="display-mega text-5xl md:text-8xl"
          style="font-family: var(--font-display);"
        >
          {SITE.author}
        </p>
        <p
          class="mt-3 text-xs font-bold tracking-widest text-[--color-mute]"
          style="font-family: var(--font-mono);"
        >
          © {year} [ FULL_STACK_IN_THE_MAKING ]
        </p>
      </div>

      <div class="md:col-span-5 md:text-right">
        <ul class="flex flex-col gap-2 md:items-end">
          <li>
            <a
              href={SOCIAL.github}
              target="_blank"
              rel="noopener"
              class="inline-block border-2 border-transparent px-3 py-1.5 text-sm font-bold hover:border-[--color-ink] hover:bg-[--color-ink] hover:text-[--color-paper]"
              style="font-family: var(--font-mono);"
            >
              GITHUB →
            </a>
          </li>
          <li>
            <a
              href="/rss.xml"
              class="inline-block border-2 border-transparent px-3 py-1.5 text-sm font-bold hover:border-[--color-ink] hover:bg-[--color-ink] hover:text-[--color-paper]"
              style="font-family: var(--font-mono);"
            >
              RSS →
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</footer>
