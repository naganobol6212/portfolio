---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Journal"
  description="MASAGIN の技術ブログ。個人開発の知見、Rails / Next.js / Nuxt を行き来する中で見えてきたこと、課題の本質を技術で解く話などを書いています。"
  path="/blog"
>
  <section class="mx-auto max-w-7xl px-5 pt-16 pb-10 md:px-10 md:pt-24">
    <div class="flex items-center gap-3 md:gap-5">
      <span class="eyebrow-chip">ブログ</span>
      <span
        class="text-xs font-bold tracking-widest opacity-60"
        style="font-family: var(--font-mono);"
      >
        / {String(posts.length).padStart(2, '0')} ENTRIES
      </span>
    </div>
    <h1 class="display-mega mt-6 text-5xl md:text-7xl">JOURNAL</h1>
    <p class="mt-5 max-w-2xl text-sm leading-relaxed md:text-base">
      個人開発の知見、技術選定の理由、課題を技術で解く話などを書いていきます。
    </p>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-24 md:px-10">
    {
      posts.length === 0 ? (
        <p class="brutal-border p-8 text-sm font-bold">まだ記事がありません。</p>
      ) : (
        <ul class="divide-y-[3px] divide-[--color-ink] brutal-border-t brutal-border-b">
          {posts.map((post) => (
            <li>
              <a
                href={`/blog/${post.id}`}
                class="group flex flex-col gap-3 px-2 py-7 transition-none hover:bg-[--color-ink] hover:text-[--color-paper] md:flex-row md:items-baseline md:gap-8 md:px-4"
              >
                <time
                  datetime={post.data.pubDate.toISOString()}
                  class="text-xs font-bold opacity-60 md:w-28"
                  style="font-family: var(--font-mono);"
                >
                  {post.data.pubDate.toISOString().slice(0, 10)}
                </time>
                <div class="flex-1">
                  <p
                    class="display-mega text-xl md:text-2xl"
                    style="font-family: var(--font-display);"
                  >
                    {post.data.title}
                  </p>
                  <p class="mt-2 text-sm leading-relaxed opacity-80">{post.data.description}</p>
                  {post.data.tags.length > 0 && (
                    <ul class="mt-3 flex flex-wrap gap-2">
                      {post.data.tags.map((tag) => (
                        <li
                          class="text-[11px] font-bold opacity-60"
                          style="font-family: var(--font-mono);"
                        >
                          #{tag}
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
                <span class="hidden text-2xl font-bold opacity-60 md:inline">→</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
