---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Works from '../components/Works.astro';
import Skills from '../components/Skills.astro';
import Contact from '../components/Contact.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <Hero />
  <About />
  <Experience />
  <Works />
  <Skills />

  <!-- 05. BLOG -->
  <section
    id="blog"
    class="relative mx-auto max-w-7xl px-5 py-20 md:px-10 md:py-32"
  >
    <div
      class="section-bg-number left-1/2 -translate-x-1/2 -top-6 md:-top-10 text-[140px] md:text-[260px]"
      aria-hidden="true"
    >
      05
    </div>

    <div class="relative z-10">
      <div class="mb-10 flex items-end justify-between gap-4 brutal-border-b pb-5">
        <div class="flex items-center gap-3 md:gap-5">
          <span class="eyebrow-chip">ブログ</span>
          <h2 class="display-mega text-2xl md:text-4xl">JOURNAL</h2>
        </div>
        <a
          href="/blog"
          class="hidden font-bold opacity-60 hover:opacity-100 md:inline-block"
          style="font-family: var(--font-mono);"
        >
          ALL →
        </a>
      </div>

      <a
        href="/blog"
        class="group relative block brutal-border overflow-hidden bg-[--color-ink] text-[--color-paper] hover:bg-[--color-paper] hover:text-[--color-ink]"
      >
        <div class="px-6 py-14 text-center md:py-24">
          <p
            class="display-mega text-[14vw] leading-none md:text-[10vw]"
            style="font-family: var(--font-display);"
          >
            READ&nbsp;THE&nbsp;JOURNAL
          </p>
          <p
            class="mt-6 text-xs font-bold tracking-widest opacity-70 md:text-sm"
            style="font-family: var(--font-mono);"
          >
            個人開発の知見・技術選定・課題を技術で解く話
          </p>
        </div>
      </a>

      {
        posts.length > 0 && (
          <ul class="mt-10 divide-y-[3px] divide-[--color-ink] brutal-border-t brutal-border-b">
            {posts.map((post) => (
              <li>
                <a
                  href={`/blog/${post.id}`}
                  class="flex flex-col gap-1 px-2 py-5 transition-none hover:bg-[--color-ink] hover:text-[--color-paper] md:flex-row md:items-baseline md:gap-6 md:px-4"
                >
                  <time
                    datetime={post.data.pubDate.toISOString()}
                    class="text-xs font-bold opacity-60 md:w-28"
                    style="font-family: var(--font-mono);"
                  >
                    {post.data.pubDate.toISOString().slice(0, 10)}
                  </time>
                  <span class="flex-1 text-base font-bold md:text-lg">{post.data.title}</span>
                  <span class="hidden text-sm font-bold opacity-60 md:inline">→</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <Contact />
</BaseLayout>
